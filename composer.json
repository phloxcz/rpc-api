{
    "name": "phloxcz/rpc-api",
    "description": "JSON-RPC 2.0 server for Nette: API controllers as DI services, with attribute-based authorization and typed parameters.",
    "keywords": ["nette", "api", "rpc", "json-rpc"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/phloxcz/rpc-api",
    "authors": [
        {
            "name": "Phlox",
            "homepage": "https://github.com/phloxcz"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../phlox-api-core",
            "options": {
                "versions": {
                    "phloxcz/api-core": "0.1.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.4",
        "nette/di": "^3.1",
        "nette/http": "^3.2",
        "nette/schema": "^1.3",
        "nette/utils": "^4.0",
        "phloxcz/api-core": "^0.1@dev"
    },
    "require-dev": {
        "nette/application": "^3.2",
        "nette/bootstrap": "^3.2",
        "nette/tester": "^2.5",
        "phpstan/phpstan": "^2.0",
        "tracy/tracy": "^2.10"
    },
    "autoload": {
        "psr-4": {
            "Phlox\\RpcApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phlox\\RpcApi\\Tests\\Fixtures\\": "tests/fixtures/"
        }
    },
    "scripts": {
        "test": "tester tests -C",
        "phpstan": "phpstan analyse",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1-dev"
        }
    }
}
